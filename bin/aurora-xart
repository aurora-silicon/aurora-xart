#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
# Runs from a source checkout as well as from an installed package
# (the package lives in ../share/aurora-xart next to this script).
import os
import sys

# No __pycache__ beside an installed package when root runs it.
sys.dont_write_bytecode = True
here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
for cand in (here, os.path.join(here, "share", "aurora-xart")):
    if os.path.isdir(os.path.join(cand, "aurora_xart")):
        sys.path.insert(0, cand)
        break

from aurora_xart.cli import main  # noqa: E402

sys.exit(main())
